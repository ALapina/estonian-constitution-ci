  "facts": [
    {
      "text": "Igaühel on õigus vabale eneseteostusele. (§ 19)",
      "ref": "ps-19-lg1"
    },
    {
      "text": "Igaüks peab oma õiguste ja vabaduste kasutamisel ning kohustuste täitmisel austama ja arvestama teiste inimeste õigusi ja vabadusi ning järgima seadust. (§ 19)",
      "ref": "ps-19-lg2"
    },
    {
      "text": "Põhiseaduses loetletud kõigi ja igaühe õigused, vabadused ja kohustused on võrdselt nii Eesti kodanikel kui ka Eestis viibivatel välisriikide kodanikel ja kodakondsuseta isikutel. (§ 9)",
      "ref": "ps-9-lg1"
    },
    {
      "text": "Eesti kodakondsus omandatakse sünniga, saadakse naturalisatsiooni korras, taastatakse või kaotatakse. (KodS § 2)",
      "ref": "kods-2-lg1"
    }
  ],
  "questions": [
    {
      "type": "choice",
      "text": "Mida peab igaüks tegema oma õiguste ja vabaduste kasutamisel?",
      "options": [
        "küsima luba kohalikult omavalitsuselt",
        "austama ja arvestama teiste inimeste õigusi ja vabadusi",
        "olema Eesti kodanik",
        "andma vande"
