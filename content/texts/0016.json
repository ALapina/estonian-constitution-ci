  "facts": [
    {
      "text": "Igal lapsel, kelle vanematest üks on Eesti kodanik, on õigus Eesti kodakondsusele sünnilt. (§ 8)",
      "ref": "ps-8-lg1"
    },
    {
      "text": "Kelleltki ei tohi veendumuste pärast võtta Eesti kodakondsust. (§ 8)",
      "ref": "ps-8-lg4"
    },
    {
      "text": "Eesti kodakondsus omandatakse sünniga, saadakse naturalisatsiooni korras või taastatakse isikule, kes on kaotanud Eesti kodakondsuse alaealisena. (KodS § 2)",
      "ref": "kods-2-lg1"
    },
    {
      "text": "Kõrgeimat riigivõimu teostab rahvas hääleõiguslike kodanike kaudu: Riigikogu valimisega ja rahvahääletusega. (§ 56)",
      "ref": "ps-56-lg1"
    }
  ],
