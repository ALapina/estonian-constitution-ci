  "facts": [
    {
      "text": "Põhiseaduse II peatükis loetletud õigused, vabadused ja kohustused ei välista muid õigusi, vabadusi ega kohustusi. (§ 10)",
      "ref": "ps-10"
    },
    {
      "text": "Muud õigused tulenevad põhiseaduse mõttest või on sellega kooskõlas ja vastavad inimväärikuse ning sotsiaalse ja demokraatliku õigusriigi põhimõtetele. (§ 10)",
      "ref": "ps-10"
    },
    {
      "text": "Seadusandlik võim kuulub Riigikogule. (§ 59)",
      "ref": "ps-59"
    },
    {
      "text": "Eesti kõrgeima riigivõimu kandja on rahvas. (§ 1)",
      "ref": "ps-1"
    }
  ],
  "questions": [
    {
      "type": "truefalse",
      "text": "Inimesel on ainult need õigused, mis on põhiseaduses kirjas.",
      "options": [
        "õige",
        "vale"
      ],
      "answer": 1,
      "explanation": "§ 10 ütleb: loetletud õigused ei välista muid õigusi, mis tulenevad põhiseaduse mõttest või on sellega kooskõlas ja vastavad inimväärikuse ning sotsiaalse ja demokraatliku õigusriigi põhimõtetele.",
      "ref": "ps-10"
    },
    {
      "type": "where",
      "text": "Kus see on kirjas? „Seadusandlik võim kuulub Riigikogule.“",
      "options": [
