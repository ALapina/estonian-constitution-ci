  "facts": [
    {
      "text": "Kodu on puutumatu. (§ 33)",
      "ref": "ps-33"
    },
    {
      "text": "Kellegi eluruumi, valdusse ega töökohta ei tohi tungida ega neid läbi otsida, välja arvatud seadusega sätestatud juhtudel ja korras. (§ 33)",
      "ref": "ps-33"
    },
    {
      "text": "Seadusega sätestatud juhtudel ja korras võib eluruumi, valdusse või töökohta tungida ja neid läbi otsida avaliku korra, tervise või teiste inimeste õiguste ja vabaduste kaitseks, kuriteo tõkestamiseks, kurjategija tabamiseks või tõe väljaselgitamiseks kriminaalmenetluses. (§ 33)",
      "ref": "ps-33"
    },
    {
      "text": "Igaühel on õigus perekonna- ja eraelu puutumatusele. (§ 26)",
      "ref": "ps-26"
    }
  ],
  "questions": [
    {
      "type": "choice",
      "text": "Millal võib põhiseaduse § 33 järgi kellegi eluruumi tungida või seda läbi otsida?",
      "options": [
        "alati, kui politsei seda soovib",
        "ainult seadusega sätestatud juhtudel ja korras, näiteks tõe väljaselgitamiseks kriminaalmenetluses",
        "ainult siis, kui omanik ei ole kodus",
        "mitte kunagi"
      ],
      "answer": 1,
      "explanation": "§ 33 ütleb: kodu on puutumatu. Kellegi eluruumi, valdusse ega töökohta ei tohi tungida ega neid läbi otsida, välja arvatud seadusega sätestatud juhtudel ja korras, näiteks tõe väljaselgitamiseks kriminaalmenetluses.",
      "ref": "ps-33"
    },
    {
      "type": "truefalse",
      "text": "Riigiasutused ja nende ametiisikud võivad sekkuda kellegi perekonna- või eraellu alati, kui nad seda soovivad.",
      "options": [
        "õige",
        "vale"
      ],
      "answer": 1,
      "explanation": "§ 26 ütleb: riigiasutused, kohalikud omavalitsused ja nende ametiisikud ei tohi kellegi perekonna- ega eraellu sekkuda muidu, kui seaduses sätestatud juhtudel ja korras tervise, kõlbluse, avaliku korra või teiste inimeste õiguste ja vabaduste kaitseks, kuriteo tõkestamiseks või kurjategija tabamiseks.",
      "ref": "ps-26"
    }
  ],
