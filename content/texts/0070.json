  "facts": [
    {
      "text": "Teadus ja kunst ning nende õpetused on vabad. Ülikoolid ja teadusasutused on seaduses ettenähtud piires autonoomsed. (§ 38)",
      "ref": "ps-38"
    },
    {
      "text": "Autoril on võõrandamatu õigus oma loomingule. Riik kaitseb autori õigusi. (§ 39)",
      "ref": "ps-39"
    },
    {
      "text": "Igaühel on südametunnistuse-, usu- ja mõttevabadus. Kuulumine kirikutesse ja usuühingutesse on vaba. Riigikirikut ei ole. Igaühel on vabadus nii üksinda kui ka koos teistega, avalikult või eraviisiliselt täita usutalitusi, kui see ei kahjusta avalikku korda, tervist ega kõlblust. (§ 40)",
      "ref": "ps-40"
    },
    {
      "text": "Igaühel on õigus jääda truuks oma arvamustele ja veendumustele. Kedagi ei tohi sundida neid muutma. Veendumustega ei saa vabandada õiguserikkumist. (§ 41)",
      "ref": "ps-41"
    },
    {
      "text": "Seadusega võib piirata nende Eesti kodanike osavõttu hääletamisest, kes on kohtu poolt süüdi mõistetud ja kannavad karistust kinnipidamiskohtades. (§ 58)",
      "ref": "ps-58"
    }
  ],
  "questions": [
    {
      "type": "where",
      "text": "Kus see on kirjas? „Autoril on võõrandamatu õigus oma loomingule.“",
      "options": [
        "§ 38",
        "§ 39",
        "§ 40",
        "§ 41"
      ],
      "answer": 1,
      "explanation": "See lause on põhiseaduse §-s 39. § 38 räägib teadusest, kunstist ja ülikoolidest, § 40 südametunnistuse-, usu- ja mõttevabadusest ning § 41 veendumustest.",
      "ref": "ps-39"
    },
    {
      "type": "truefalse",
      "text": "Põhiseaduse järgi võib inimese võtta õiguslikule vastutusele tema veendumuste pärast.",
      "options": [
        "õige",
        "vale"
      ],
      "answer": 1,
      "explanation": "§ 41 kolmas lõige ütleb: kedagi ei saa veendumuste pärast võtta õiguslikule vastutusele. Aga teine lõige ütleb ka: veendumustega ei saa vabandada õiguserikkumist.",
      "ref": "ps-41-lg3"
    }
  ],
