  "facts": [
    {
      "text": "Kõik on seaduse ees võrdsed. (§ 12)",
      "ref": "ps-12-lg1"
    },
    {
      "text": "Kedagi ei tohi diskrimineerida rahvuse, rassi, nahavärvuse, soo, keele, päritolu, usutunnistuse, veendumuste, varalise ja sotsiaalse seisundi või muude asjaolude tõttu. (§ 12)",
      "ref": "ps-12-lg1"
    },
    {
      "text": "Rahvusliku, rassilise, usulise või poliitilise vihkamise, vägivalla ja diskrimineerimise õhutamine on seadusega keelatud ja karistatav. (§ 12)",
      "ref": "ps-12-lg2"
    },
    {
      "text": "Täidesaatev riigivõim kuulub Vabariigi Valitsusele. (§ 86)",
      "ref": "ps-86"
    }
  ],
