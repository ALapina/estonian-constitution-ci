  "facts": [
    {
      "text": "Igaühel on õigus tema poolt või temale posti, telegraafi, telefoni või muul üldkasutataval teel edastatavate sõnumite saladusele. (§ 43)",
      "ref": "ps-43"
    },
    {
      "text": "Erandeid võib kohtu loal teha kuriteo tõkestamiseks või kriminaalmenetluses tõe väljaselgitamiseks seadusega sätestatud juhtudel ja korras. (§ 43)",
      "ref": "ps-43"
    },
    {
      "text": "Kodu on puutumatu. (§ 33)",
      "ref": "ps-33"
    }
  ],
