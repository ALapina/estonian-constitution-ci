  "facts": [
    {
      "text": "Kohtuistungid on avalikud. (§ 24)",
      "ref": "ps-24-lg3"
    },
    {
      "text": "Kohus võib seaduses sätestatud juhtudel ja korras kuulutada istungi või osa sellest kinniseks riigi- või ärisaladuse, kõlbluse või inimeste perekonna- ja eraelu kaitseks või kui seda nõuavad alaealise, kannatanu või õigusemõistmise huvid. (§ 24)",
      "ref": "ps-24-lg3"
    },
    {
      "text": "Igaühel on õigus olla oma kohtuasja arutamise juures. (§ 24)",
      "ref": "ps-24-lg2"
    },
    {
      "text": "Kedagi ei tohi tema vaba tahte vastaselt üle viia seadusega määratud kohtu alluvusest teise kohtu alluvusse. (§ 24)",
      "ref": "ps-24-lg1"
    },
    {
      "text": "Kellegi au ega head nime ei tohi teotada. (§ 17)",
      "ref": "ps-17"
    }
  ],
