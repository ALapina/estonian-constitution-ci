  "facts": [
    {
      "text": "Eesti on iseseisev ja sõltumatu demokraatlik vabariik, kus kõrgeima riigivõimu kandja on rahvas. (§ 1)",
      "ref": "ps-1-lg1"
    },
    {
      "text": "Eesti riigi maa-ala, territoriaalveed ja õhuruum on lahutamatu ja jagamatu tervik. (§ 2)",
      "ref": "ps-2-lg1"
    },
    {
      "text": "Riigivõimu teostatakse üksnes põhiseaduse ja sellega kooskõlas olevate seaduste alusel. (§ 3)",
      "ref": "ps-3-lg1"
    },
    {
      "text": "Riigikogu, Vabariigi Presidendi, Vabariigi Valitsuse ja kohtute tegevus on korraldatud võimude lahususe ja tasakaalustatuse põhimõttel. (§ 4)",
      "ref": "ps-4-lg1"
    }
  ],
