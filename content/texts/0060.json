      ],
      "answer": 1,
      "explanation": "§ 32 lõige 1 ütleb: omandit võib omaniku nõusolekuta võõrandada ainult seaduses sätestatud juhtudel ja korras üldistes huvides õiglase ja kohese hüvituse eest.",
      "ref": "ps-32-lg1"
    }
