  "facts": [
    {
      "text": "Igaühel on õigus vabadusele ja isikupuutumatusele. (§ 20)",
      "ref": "ps-20-lg1"
    },
    {
      "text": "Vabaduse võib võtta ainult seaduses sätestatud juhtudel ja korras. Need juhud on loetletud § 20 teises lõikes. (§ 20)",
      "ref": "ps-20-lg2"
    },
    {
      "text": "Vabaduse võib võtta kuriteo või haldusõiguserikkumise ärahoidmiseks, sellises õiguserikkumises põhjendatult kahtlustatava toimetamiseks pädeva riigiorgani ette või tema pakkumineku vältimiseks. (§ 20)",
      "ref": "ps-20-lg2-p3"
    },
    {
      "text": "Teises peatükis loetletud õigused, vabadused ja kohustused ei välista muid õigusi, vabadusi ega kohustusi, mis tulenevad põhiseaduse mõttest või on sellega kooskõlas ja vastavad inimväärikuse ning sotsiaalse ja demokraatliku õigusriigi põhimõtetele. (§ 10)",
      "ref": "ps-10"
    }
  ],
  "questions": [
    {
      "type": "truefalse",
      "text": "Politsei võib inimese vabaduse võtta, kui inimene näeb imelik välja.",
      "options": [
        "õige",
        "vale"
      ],
      "answer": 1,
      "explanation": "§ 20 ütleb: igaühel on õigus vabadusele ja isikupuutumatusele. Vabaduse võib võtta ainult seaduses sätestatud juhtudel ja korras. Imelik välimus ei ole üks neist juhtudest.",
      "ref": "ps-20-lg2"
    },
    {
      "type": "where",
      "text": "Kus see on kirjas? „Igaühel on õigus vabadusele ja isikupuutumatusele.“",
