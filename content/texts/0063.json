  "facts": [
    {
      "text": "Ühtki Eesti kodanikku ei tohi Eestist välja saata ega takistada Eestisse asumast. (§ 36)",
      "ref": "ps-36-lg1"
    },
    {
      "text": "Ühtki Eesti kodanikku ei tohi välisriigile välja anda muidu, kui välislepingus ettenähtud juhtudel ning vastavas lepingus ja seaduses sätestatud korras. (§ 36)",
      "ref": "ps-36-lg2"
    },
    {
      "text": "Väljaandmise otsustab Vabariigi Valitsus. Igal väljaantaval on õigus vaidlustada väljaandmine Eesti kohtus. (§ 36)",
      "ref": "ps-36-lg2"
    },
    {
      "text": "Igal eestlasel on õigus asuda Eestisse. (§ 36)",
      "ref": "ps-36-lg3"
    },
    {
      "text": "Kui seadus ei sätesta teisiti, on õigus vabalt valida tegevusala, elukutset ja töökohta võrdselt Eesti kodanikuga ka Eestis viibival välisriigi kodanikul ja kodakondsuseta isikul. (§ 29)",
      "ref": "ps-29-lg1"
    }
  ],
