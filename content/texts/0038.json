  "facts": [
    {
      "text": "Igaühele, kellelt on võetud vabadus, teatatakse viivitamatult talle arusaadavas keeles ja viisil vabaduse võtmise põhjus ja tema õigused. (§ 21)",
      "ref": "ps-21-lg1"
    },
    {
      "text": "Inimesele, kellelt on võetud vabadus, antakse võimalus teatada vabaduse võtmisest oma lähedastele. (§ 21)",
      "ref": "ps-21-lg1"
    },
    {
      "text": "Kuriteos kahtlustatavale antakse viivitamatult ka võimalus valida endale kaitsja ja kohtuda temaga. (§ 21)",
      "ref": "ps-21-lg1"
    },
    {
      "text": "Kedagi ei tohi vahi all pidada üle neljakümne kaheksa tunni ilma kohtu loata. (§ 21)",
      "ref": "ps-21-lg2"
    },
    {
      "text": "Igaühel on õigus riigi ja seaduse kaitsele. Seadus kaitseb igaühte riigivõimu omavoli eest. (§ 13)",
      "ref": "ps-13"
    }
  ],
  "questions": [
    {
      "type": "choice",
      "text": "Mis keeles teatatakse inimesele, kellelt on võetud vabadus, vabaduse võtmise põhjus?",
      "options": [
        "ainult eesti keeles",
        "eesti või vene keeles",
        "talle arusaadavas keeles",
        "eesti ja inglise keeles"
      ],
      "answer": 2,
      "explanation": "§ 21 ütleb: igaühele, kellelt on võetud vabadus, teatatakse viivitamatult talle arusaadavas keeles ja viisil vabaduse võtmise põhjus ja tema õigused.",
      "ref": "ps-21-lg1"
    },
    {
      "type": "truefalse",
      "text": "Seadus kaitseb riigivõimu omavoli eest ainult Eesti kodanikke.",
      "options": [
        "õige",
        "vale"
      ],
      "answer": 1,
      "explanation": "§ 13 ütleb: seadus kaitseb igaühte riigivõimu omavoli eest. § 9 järgi on kõigi ja igaühe õigused võrdselt ka Eestis viibivatel välisriikide kodanikel ja kodakondsuseta isikutel.",
      "ref": "ps-13-lg2"
    }
  ],
