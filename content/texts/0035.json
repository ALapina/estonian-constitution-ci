  "facts": [
    {
      "text": "Kellegi au ega head nime ei tohi teotada. (§ 17)",
      "ref": "ps-17"
    },
    {
      "text": "Kedagi ei tohi piinata, julmalt või väärikust alandavalt kohelda ega karistada. (§ 18)",
      "ref": "ps-18-lg1"
    },
    {
      "text": "Igaühel on õigus vabale eneseteostusele. Igaüks peab oma õiguste ja vabaduste kasutamisel ning kohustuste täitmisel austama ja arvestama teiste inimeste õigusi ja vabadusi ning järgima seadust. (§ 19)",
      "ref": "ps-19"
    },
    {
      "text": "Igaühel on õigus vabadusele ja isikupuutumatusele. Vabaduse võib võtta ainult seaduses sätestatud juhtudel ja korras. (§ 20)",
      "ref": "ps-20"
    }
  ],
