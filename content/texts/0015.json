  "facts": [
    {
      "text": "Hääleõiguslik on Eesti kodanik, kes on saanud 18-aastaseks. (§ 57)",
      "ref": "ps-57-lg1"
    },
    {
      "text": "Seadusega võib piirata nende Eesti kodanike hääletamist, kes on kohtu poolt süüdi mõistetud ja kannavad karistust kinnipidamiskohas. (§ 58)",
      "ref": "ps-58"
    },
    {
      "text": "Igaühe õigused, vabadused ja kohustused on võrdselt Eesti kodanikel ning Eestis viibivatel välisriikide kodanikel ja kodakondsuseta isikutel. (§ 9)",
      "ref": "ps-9-lg1"
    },
    {
      "text": "Kõik on seaduse ees võrdsed. (§ 12)",
      "ref": "ps-12-lg1"
    },
    {
      "text": "Seadusandlik võim kuulub Riigikogule. (§ 59)",
      "ref": "ps-59"
    }
  ],
  "questions": [
    {
      "type": "choice",
      "text": "Kes on Eesti riigipea?",
