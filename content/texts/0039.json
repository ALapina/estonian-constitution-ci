  "facts": [
    {
      "text": "Kedagi ei tohi vahi all pidada üle neljakümne kaheksa tunni ilma kohtu sellekohase loata. (§ 21)",
      "ref": "ps-21-lg2"
    },
    {
      "text": "Kohtu otsus teatatakse vahistatule viivitamatult talle arusaadavas keeles ja viisil. (§ 21)",
      "ref": "ps-21-lg2"
    },
    {
      "text": "Kelleltki ei tohi võtta sünniga omandatud Eesti kodakondsust. (§ 8)",
      "ref": "ps-8-lg3"
    },
    {
      "text": "Rassilise vihkamise, vägivalla ja diskrimineerimise õhutamine on seadusega keelatud ja karistatav. (§ 12)",
      "ref": "ps-12-lg2"
    },
    {
      "text": "Õiguste ja vabaduste tagamine on seadusandliku, täidesaatva ja kohtuvõimu ning kohalike omavalitsuste kohustus. (§ 14)",
      "ref": "ps-14"
    }
  ],
