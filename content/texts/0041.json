  "facts": [
    {
      "text": "Kedagi ei tohi käsitada kuriteos süüdi olevana enne, kui tema kohta on jõustunud süüdimõistev kohtuotsus. (§ 22)",
      "ref": "ps-22-lg1"
    },
    {
      "text": "Keegi ei ole kriminaalmenetluses kohustatud oma süütust tõendama. (§ 22)",
      "ref": "ps-22-lg2"
    },
    {
      "text": "Kedagi ei tohi sundida tunnistama iseenda või oma lähedaste vastu. (§ 22)",
      "ref": "ps-22-lg3"
    },
    {
      "text": "Igaühel on õigus pöörduda oma õiguste ja vabaduste rikkumise korral kohtusse. (§ 15)",
      "ref": "ps-15-lg1"
    },
    {
      "text": "Kellegi au ega head nime ei tohi teotada. (§ 17)",
      "ref": "ps-17"
    }
  ],
