  "facts": [
    {
      "text": "Riigiasutused, kohalikud omavalitsused ja nende ametiisikud ei tohi Eesti kodaniku vaba tahte vastaselt koguda ega talletada andmeid tema veendumuste kohta. (§ 42)",
      "ref": "ps-42"
    },
    {
      "text": "Välismaalane, kes soovib saada Eesti kodakondsust, peab andma vande: „Taotledes Eesti kodakondsust, tõotan olla ustav Eesti põhiseaduslikule korrale.“ (KodS § 6)",
      "ref": "kods-6-lg1-p7"
    },
    {
      "text": "Igaühe omand on puutumatu ja võrdselt kaitstud. (§ 32)",
      "ref": "ps-32-lg1"
    }
  ],
