  "facts": [
    {
      "text": "Igaühel on õigus pöörduda oma õiguste ja vabaduste rikkumise korral kohtusse. (§ 15)",
      "ref": "ps-15-lg1"
    },
    {
      "text": "Igaüks võib oma kohtuasjas nõuda asjassepuutuva seaduse, muu õigusakti või toimingu põhiseadusevastaseks tunnistamist. (§ 15)",
      "ref": "ps-15-lg1"
    },
    {
      "text": "Kohus tunnistab põhiseadusevastaseks seaduse, muu õigusakti või toimingu, mis rikub põhiseaduses sätestatud õigusi ja vabadusi või on põhiseadusega vastuolus. (§ 15)",
      "ref": "ps-15-lg2"
    },
    {
      "text": "Õigust mõistab ainult kohus. Kohus on oma tegevuses sõltumatu. (§ 146)",
      "ref": "ps-146"
    }
  ],
