  "facts": [
    {
      "text": "Igaühel on õigus talle ükskõik kelle poolt õigusvastaselt tekitatud moraalse ja materiaalse kahju hüvitamisele. (§ 25)",
      "ref": "ps-25"
    },
    {
      "text": "Õigus talle õigusvastaselt tekitatud kahju hüvitamisele on igaühel, mitte ainult Eesti kodanikul. (§ 25)",
      "ref": "ps-25"
    },
    {
      "text": "Kahju võib olla õigusvastaselt tekitanud ükskõik kes, mitte ainult riik. (§ 25)",
      "ref": "ps-25"
    },
    {
      "text": "Igaüks peab oma õiguste ja vabaduste kasutamisel ning kohustuste täitmisel austama ja arvestama teiste inimeste õigusi ja vabadusi ning järgima seadust. (§ 19)",
      "ref": "ps-19-lg2"
    }
  ],
