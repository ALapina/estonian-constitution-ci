  "facts": [
    {
      "text": "Ametikohad riigiasutustes ja kohalikes omavalitsustes täidetakse seaduse alusel ja korras Eesti kodanikega. (§ 30)",
      "ref": "ps-30-lg1"
    },
    {
      "text": "Kooskõlas seadusega võib neid ametikohti erandkorras täita ka välisriigi kodanike ja kodakondsuseta isikutega. (§ 30)",
      "ref": "ps-30-lg1"
    },
    {
      "text": "Seadus võib piirata mõne kategooria riigiteenistujate õigust tegelda ettevõtlusega ja koonduda tulundusühendustesse ning õigust kuuluda erakondadesse ja mõnda liiki mittetulundusühendustesse. (§ 30)",
      "ref": "ps-30-lg2"
    },
    {
      "text": "Erakondadesse võivad kuuluda ainult Eesti kodanikud. (§ 48)",
      "ref": "ps-48-lg1"
    },
    {
      "text": "Kedagi ei tohi süüdi mõista teo eest, kui seda tegu ei tunnista kuriteoks seadus, mis oli jõus teo toimepanemise ajal. (§ 23)",
      "ref": "ps-23-lg1"
    }
  ],
