  "facts": [
    {
      "text": "Välismaalane, kes soovib saada Eesti kodakondsust, peab olema vähemalt 15-aastane. (KodS § 6)",
      "ref": "kods-6-lg1-p1"
    },
    {
      "text": "Välismaalane peab olema elanud Eestis elamisloa või elamisõiguse alusel vähemalt kaheksa aastat, millest viis aastat püsivalt. (KodS § 6)",
      "ref": "kods-6-lg1-p2_1"
    },
    {
      "text": "Välismaalane peab tundma Eesti Vabariigi põhiseadust ja kodakondsuse seadust ning omama legaalset püsivat sissetulekut. (KodS § 6)",
      "ref": "kods-6-lg1"
    },
    {
      "text": "Välismaalane annab vande: „Taotledes Eesti kodakondsust, tõotan olla ustav Eesti põhiseaduslikule korrale.“ (KodS § 6)",
      "ref": "kods-6-lg1-p7"
    },
    {
      "text": "Seadusega võib piirata nende Eesti kodanike osavõttu hääletamisest, kes on kohtu poolt süüdi mõistetud ja kannavad karistust kinnipidamiskohtades. (§ 58)",
      "ref": "ps-58"
    }
  ],
