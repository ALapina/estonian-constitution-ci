  "facts": [
    {
      "text": "Põhiseaduses loetletud igaühe õigused, vabadused ja kohustused on võrdselt Eesti kodanikel ning Eestis viibivatel välisriikide kodanikel ja kodakondsuseta isikutel. (§ 9)",
      "ref": "ps-9-lg1"
    },
    {
      "text": "Kõik on seaduse ees võrdsed. (§ 12)",
      "ref": "ps-12-lg1"
    },
    {
      "text": "Kedagi ei tohi diskrimineerida näiteks rahvuse, keele, soo või päritolu tõttu. (§ 12)",
      "ref": "ps-12-lg1"
    },
    {
      "text": "Eesti riigikeel on eesti keel. (§ 6)",
      "ref": "ps-6"
    },
    {
      "text": "Hääleõiguslik on Eesti kodanik, kes on saanud 18-aastaseks. (§ 57)",
      "ref": "ps-57-lg1"
    }
  ],
