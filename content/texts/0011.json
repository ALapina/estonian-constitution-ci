  "facts": [
    {
      "text": "Hääleõiguslik on Eesti kodanik, kes on saanud 18-aastaseks. (§ 57)",
      "ref": "ps-57-lg1"
    },
    {
      "text": "16-aastane Eesti kodanik ei saa veel Riigikogu valimistel hääletada. (§ 57)",
      "ref": "ps-57-lg1"
    },
    {
      "text": "Hääleõiguslik ei ole Eesti kodanik, kelle kohus on tunnistanud teovõimetuks. (§ 57)",
      "ref": "ps-57-lg2"
    },
    {
      "text": "Rahvas teostab kõrgeimat riigivõimu hääleõiguslike kodanike kaudu: Riigikogu valimisel ja rahvahääletusel. (§ 56)",
      "ref": "ps-56"
    },
    {
      "text": "Riigikogu, president, valitsus ja kohtud töötavad võimude lahususe ja tasakaalustatuse põhimõttel. (§ 4)",
      "ref": "ps-4"
    }
  ],
  "questions": [
    {
      "type": "choice",
      "text": "Kes on põhiseaduse § 57 järgi hääleõiguslik?",
      "options": [
        "Eesti kodanik, kes on saanud 16-aastaseks",
        "Eesti kodanik, kes on saanud 18-aastaseks",
        "Iga Eestis elav inimene, kes on saanud 18-aastaseks"
      ],
      "answer": 1,
      "explanation": "§ 57 järgi on hääleõiguslik Eesti kodanik, kes on saanud kaheksateist aastat vanaks. Ta peab olema Eesti kodanik ja vähemalt 18-aastane.",
      "ref": "ps-57-lg1"
    },
    {
      "type": "truefalse",
      "text": "Eesti kodanik, kelle kohus on tunnistanud teovõimetuks, on hääleõiguslik.",
