  "facts": [
    {
      "text": "Vabaduse võib võtta ainult seaduses sätestatud juhtudel ja korras. (§ 20)",
      "ref": "ps-20-lg2"
    },
    {
      "text": "Vabaduse võib võtta nakkushaige, vaimuhaige, alkohooliku või narkomaani kinnipidamiseks, kui ta on endale või teistele ohtlik. (§ 20)",
      "ref": "ps-20-lg2-p5"
    },
    {
      "text": "Vabaduse võib võtta alaealise üle kasvatusliku järelevalve sisseseadmiseks. (§ 20)",
      "ref": "ps-20-lg2-p4"
    },
    {
      "text": "Vabaduse võib võtta kuriteo või haldusõiguserikkumise ärahoidmiseks. (§ 20)",
      "ref": "ps-20-lg2-p3"
    },
    {
      "text": "Õigusi ja vabadusi tohib piirata ainult kooskõlas põhiseadusega. Need piirangud peavad olema demokraatlikus ühiskonnas vajalikud ega tohi moonutada piiratavate õiguste ja vabaduste olemust. (§ 11)",
      "ref": "ps-11"
    }
  ],
