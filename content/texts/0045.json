  "facts": [
    {
      "text": "Kedagi ei tohi käsitada kuriteos süüdi olevana enne, kui tema kohta on jõustunud süüdimõistev kohtuotsus. (§ 22)",
      "ref": "ps-22-lg1"
    },
    {
      "text": "Keegi ei ole kriminaalmenetluses kohustatud oma süütust tõendama. (§ 22)",
      "ref": "ps-22-lg2"
    },
    {
      "text": "Kedagi ei tohi teist korda kohtu alla anda ega karistada teo eest, milles teda vastavalt seadusele on mõistetud lõplikult süüdi või õigeks. (§ 23)",
      "ref": "ps-23-lg3"
    },
    {
      "text": "Kohtuistungid on avalikud. Kohus võib seaduses sätestatud juhtudel ja korras kuulutada istungi kinniseks, näiteks ärisaladuse kaitseks. (§ 24)",
      "ref": "ps-24-lg3"
    },
    {
      "text": "Igaühel on õigus tema kohta tehtud kohtu otsuse peale seadusega sätestatud korras edasi kaevata kõrgemalseisvale kohtule. (§ 24)",
      "ref": "ps-24-lg5"
    }
  ],
  "questions": [
