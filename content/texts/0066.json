  "facts": [
    {
      "text": "Teadus ja kunst ning nende õpetused on vabad. (§ 38)",
      "ref": "ps-38-lg1"
    },
    {
      "text": "Ülikoolid ja teadusasutused on seaduses ettenähtud piires autonoomsed. (§ 38)",
      "ref": "ps-38-lg2"
    },
    {
      "text": "Riigikogu, Vabariigi Presidendi, Vabariigi Valitsuse ja kohtute tegevus on korraldatud võimude lahususe ja tasakaalustatuse põhimõttel. (§ 4)",
      "ref": "ps-4"
    },
    {
      "text": "Eesti kodanikul on õigus vabalt valida tegevusala, elukutset ja töökohta. Seadus võib sätestada selle õiguse kasutamise tingimused ja korra. Kui seadus ei sätesta teisiti, on see õigus võrdselt Eesti kodanikuga ka Eestis viibival välisriigi kodanikul ja kodakondsuseta isikul. (§ 29)",
      "ref": "ps-29-lg1"
    }
  ],
  "questions": [
    {
      "type": "choice",
      "text": "Mis on põhiseaduse § 38 järgi seaduses ettenähtud piires autonoomsed?",
      "options": [
        "ülikoolid ja teadusasutused",
        "kõik koolid ja lasteaiad",
        "ajalehed ja raadiojaamad",
        "erakonnad ja ühingud"
      ],
      "answer": 0,
      "explanation": "§ 38 teine lõige ütleb: ülikoolid ja teadusasutused on seaduses ettenähtud piires autonoomsed. Autonoomne tähendab, et nad otsustavad oma asjade üle ise, aga ainult seaduses ettenähtud piires.",
      "ref": "ps-38-lg2"
    },
    {
      "type": "truefalse",
      "text": "Põhiseaduse järgi otsustab riik, millise elukutse Eesti kodanik valib.",
      "options": [
        "õige",
        "vale"
      ],
      "answer": 1,
      "explanation": "§ 29 ütleb: Eesti kodanikul on õigus vabalt valida tegevusala, elukutset ja töökohta. Seadus võib sätestada selle õiguse kasutamise tingimused ja korra, aga elukutse valib inimene ise.",
      "ref": "ps-29-lg1"
    }
  ],
