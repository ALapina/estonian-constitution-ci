  "facts": [
    {
      "text": "Kohtuotsus kuulutatakse avalikult, välja arvatud juhud, kui alaealise, abielupoole või kannatanu huvid nõuavad teisiti. (§ 24)",
      "ref": "ps-24-lg4"
    },
    {
      "text": "Igaühel on õigus tema kohta tehtud kohtu otsuse peale seadusega sätestatud korras edasi kaevata kõrgemalseisvale kohtule. (§ 24)",
      "ref": "ps-24-lg5"
    },
    {
      "text": "Kedagi ei tohi piinata, julmalt või väärikust alandavalt kohelda ega karistada. (§ 18)",
      "ref": "ps-18-lg1"
    },
    {
      "text": "Kedagi ei tohi tema vaba tahte vastaselt allutada meditsiini- ega teaduskatsetele. (§ 18)",
      "ref": "ps-18-lg2"
    }
  ],
