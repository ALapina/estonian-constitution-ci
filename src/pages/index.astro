---
import TextList, { type ListGroup } from '../components/TextList';
import Base from '../layouts/Base.astro';
import { allTexts, citation, STAGE_TITLES } from '../lib/content';
import type { Stage, TextType } from '../lib/types';
import { url } from '../lib/url';

const TYPE_LABELS: Record<TextType, string> = {
  serial: 'сериал',
  side: 'отдельная история',
  summary: 'итог',
  review: 'повторение',
};

const texts = allTexts();

const actLabel = (id: string) => (id.startsWith('ps-') ? 'PS' : 'KodS');
// Summary and review texts have no law block: list the § their facts and questions bring back.
const refsOf = (t: (typeof texts)[number]) =>
  t.law.length ? t.law : [...new Set([...t.facts, ...t.questions].map((x) => x.ref.split('-lg')[0]))];

const groups: ListGroup[] = ([0, 1, 2, 3, 4] as Stage[])
  .map((stage) => ({
    title: STAGE_TITLES[stage],
    items: texts
      .filter((t) => t.stage === stage)
      .map((t) => ({
        id: t.id,
        title: t.title,
        href: url(`t/${t.id}/`),
        kind: TYPE_LABELS[t.type],
        refs: refsOf(t).map((id) => `${actLabel(id)} ${citation(id)}`).join(', '),
      })),
  }))
  .filter((g) => g.items.length > 0);
---

<Base>
  <h1 lang="et">Põhiseadus lugudes</h1>
  <p class="lead">
    Короткие истории на эстонском с аудио для экзамена на знание Конституции и Закона о гражданстве.
    Каждый текст объясняет один–три параграфа закона и вводит несколько новых слов из словаря экзамена.
    Сначала совсем простой язык, потом постепенно сложнее.
  </p>
  {groups.length === 0 && <p>Первые тексты скоро появятся.</p>}
  {groups.length > 0 && <TextList client:load groups={groups} />}
</Base>
